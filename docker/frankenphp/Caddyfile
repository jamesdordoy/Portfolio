{
	skip_install_trust
	# TLS is terminated by Cloudflare; this server only speaks plain HTTP inside the network
	auto_https off
	admin off
	frankenphp
}

:8080 {
	root public/
	encode zstd br gzip

	# Vite output is content-hashed, so it can be cached forever
	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	php_server
}
