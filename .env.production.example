# Production environment for the Docker stack (compose.yaml).
# Copy to .env on the server and fill in the blanks. Service hosts (DB_HOST, REDIS_HOST,
# INERTIA_SSR_URL), APP_ENV/APP_DEBUG, the cache/queue drivers and logging are set by compose.yaml.

APP_NAME=Portfolio
# Generate with: docker compose run --rm --no-deps migrate php artisan key:generate --show
APP_KEY=
APP_URL=https://jamesdordoy.co.uk

LOG_LEVEL=warning

# Host port for direct access (the tunnel service reaches web:8080 over the Docker network instead).
# Use APP_BIND=0.0.0.0 to expose it on the LAN.
APP_BIND=127.0.0.1
APP_PORT=8080

# Run the bundled Cloudflare Tunnel connector (tunnel service) with the token from the Zero Trust dashboard
COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# MySQL (created on first start). DB_USERNAME must not be root.
DB_DATABASE=portfolio
DB_USERNAME=portfolio
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Baked into the JS bundle at build time — rebuild the images after changing it
VITE_RECAPTCHA_SITE_KEY=

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE=

DISCORD_ALERT_WEBHOOK=
