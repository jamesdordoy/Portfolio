{% set socials = [
    { label: 'GitHub', href: 'https://github.com/jamesdordoy' },
    { label: 'LinkedIn', href: 'https://www.linkedin.com/in/james-dordoy-a80686110/' },
] %}

<section class="relative flex min-h-screen items-center justify-center overflow-hidden">
    <div class="relative z-10 mx-auto max-w-4xl px-4 text-center">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-cyan-600/20 bg-cyan-50 px-3 py-1 text-xs font-medium text-cyan-700 dark:border-cyan-400/20 dark:bg-cyan-400/10 dark:text-cyan-300">
            <span class="h-1.5 w-1.5 rounded-full bg-cyan-500 dark:bg-cyan-400"></span>
            Available for opportunities
        </div>

        <h1 class="mb-6 text-5xl font-bold tracking-tight text-slate-900 dark:text-zinc-50 sm:text-6xl lg:text-7xl">
            James&nbsp;<span class="bg-linear-to-r from-cyan-600 to-blue-600 bg-clip-text text-transparent dark:from-cyan-400 dark:to-blue-400">Dordoy</span>
        </h1>

        <p class="mb-4 text-xl font-medium text-slate-600 dark:text-zinc-400 sm:text-2xl">Full Stack Developer</p>
        <p class="mb-10 text-base text-slate-500 dark:text-zinc-500">
            Building web applications with Symfony, Twig &amp; Stimulus · Based in Essex
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
            <a href="#projects" class="inline-flex items-center gap-2 rounded-full bg-cyan-600 px-6 py-3 text-sm font-semibold text-white transition hover:bg-cyan-700">
                View Projects
                <span aria-hidden="true">↓</span>
            </a>
            <a href="#contact" class="inline-flex items-center gap-2 rounded-full border border-gray-300 px-6 py-3 text-sm font-semibold text-slate-700 transition hover:bg-gray-50 dark:border-zinc-700 dark:text-zinc-200 dark:hover:bg-zinc-900">
                <span aria-hidden="true">✉</span>
                Get in Touch
            </a>
        </div>

        <div class="mt-10 flex items-center justify-center gap-6">
            {% for social in socials %}
                <a href="{{ social.href }}" target="_blank" rel="noopener" aria-label="{{ social.label }}"
                   class="text-sm font-medium text-slate-500 transition hover:text-slate-900 dark:text-zinc-500 dark:hover:text-zinc-100">
                    {{ social.label }}
                </a>
            {% endfor %}
        </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce text-slate-400 dark:text-zinc-600" aria-hidden="true">↓</div>
</section>
