{% props project %}

<div class="card flex h-full flex-col p-6">
    <div class="mb-4 flex items-start justify-between gap-3">
        <h3 class="text-lg font-semibold text-slate-900 dark:text-zinc-100">{{ project.name }}</h3>
        {% if project.complete %}
            <span class="tag whitespace-nowrap">Complete</span>
        {% else %}
            <span class="whitespace-nowrap rounded-full border border-amber-500/30 bg-amber-50 px-2.5 py-0.5 text-xs font-medium text-amber-700 dark:border-amber-400/20 dark:bg-amber-400/10 dark:text-amber-300">
                In progress
            </span>
        {% endif %}
    </div>

    <p class="mb-4 flex-1 text-sm leading-relaxed text-slate-600 dark:text-zinc-400">{{ project.description }}</p>

    {% if project.languages|length > 0 %}
        <div class="mb-4 flex flex-wrap gap-2">
            {% for language in project.languages %}
                <span class="tag">{{ language.name }}</span>
            {% endfor %}
        </div>
    {% endif %}

    {% if project.link %}
        <a href="{{ project.link }}" target="_blank" rel="noopener"
           class="text-sm font-semibold text-cyan-600 transition hover:text-cyan-700 dark:text-cyan-400 dark:hover:text-cyan-300">
            View project →
        </a>
    {% endif %}
</div>
