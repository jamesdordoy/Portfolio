{% props form %}

<div class="grid gap-16 lg:grid-cols-2">
    <div>
        <p class="section-heading">Get in Touch</p>
        <h2 class="section-title">Let's Work Together</h2>
        <p class="mb-8 text-base leading-relaxed text-slate-600 dark:text-zinc-400">
            I'm always open to discussing new projects, interesting ideas, or opportunities to be part of something
            great. Drop me a message and I'll get back to you as soon as I can.
        </p>
        <div class="space-y-3 text-sm text-slate-500 dark:text-zinc-500">
            <p>📍 Essex, United Kingdom</p>
            <p>💼 Available for freelance &amp; full-time roles</p>
        </div>
    </div>

    <div>
        {% for _ in app.flashes('contact_sent') %}
            <div class="card mb-5 p-5 text-sm text-slate-600 dark:text-zinc-400">
                Thanks for reaching out — I'll get back to you within a week.
            </div>
        {% endfor %}

        {{ form_start(form, { attr: { class: 'space-y-5' } }) }}
            <div>
                {{ form_label(form.name, 'Name', { label_attr: { class: 'mb-1.5 block text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-zinc-400' } }) }}
                {{ form_widget(form.name, { attr: { class: 'w-full rounded-lg border border-gray-200 bg-white px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 transition-colors focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 dark:placeholder-zinc-500 dark:focus:border-cyan-400 dark:focus:ring-cyan-400', placeholder: 'John Smith' } }) }}
                {{ form_errors(form.name) }}
            </div>

            <div>
                {{ form_label(form.email, 'Email', { label_attr: { class: 'mb-1.5 block text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-zinc-400' } }) }}
                {{ form_widget(form.email, { attr: { class: 'w-full rounded-lg border border-gray-200 bg-white px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 transition-colors focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 dark:placeholder-zinc-500 dark:focus:border-cyan-400 dark:focus:ring-cyan-400', placeholder: 'john@example.com' } }) }}
                {{ form_errors(form.email) }}
            </div>

            <div>
                {{ form_label(form.message, 'Message', { label_attr: { class: 'mb-1.5 block text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-zinc-400' } }) }}
                {{ form_widget(form.message, { attr: { class: 'w-full rounded-lg border border-gray-200 bg-white px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 transition-colors focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 dark:placeholder-zinc-500 dark:focus:border-cyan-400 dark:focus:ring-cyan-400', rows: 6, placeholder: 'Hello, World!' } }) }}
                {{ form_errors(form.message) }}
            </div>

            {{ form_rest(form) }}

            <button type="submit" class="inline-flex cursor-pointer items-center gap-2 rounded-lg bg-cyan-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-cyan-500 dark:bg-cyan-500 dark:hover:bg-cyan-400">
                Send Message
                <span aria-hidden="true">→</span>
            </button>
        {{ form_end(form) }}
    </div>
</div>
