{% extends 'base.html.twig' %}

{% block title %}James Dordoy - Portfolio{% endblock %}

{% block body %}
    <div class="min-h-screen bg-white font-sans antialiased dark:bg-zinc-950">
        <twig:Navigation />
        <twig:Hero />

        <section class="border-t border-gray-100 bg-gray-50 py-24 dark:border-zinc-800/50 dark:bg-zinc-900/50">
            <div class="mx-auto max-w-6xl px-4 lg:px-8">
                <span id="about" class="jd-bookmark"></span>
                <twig:About />
            </div>
        </section>

        <section class="py-24">
            <div class="mx-auto max-w-6xl px-4 lg:px-8">
                <span id="projects" class="jd-bookmark"></span>
                <twig:ProjectsSection :projects="projects" />
            </div>
        </section>

        <section class="border-t border-gray-100 bg-gray-50 py-24 dark:border-zinc-800/50 dark:bg-zinc-900/50">
            <div class="mx-auto max-w-6xl px-4 lg:px-8">
                <span id="experience" class="jd-bookmark"></span>
                <twig:ExperienceSection :timeline="timeline" />
            </div>
        </section>

        <section class="py-24">
            <div class="mx-auto max-w-6xl px-4 lg:px-8">
                <span id="contact" class="jd-bookmark"></span>
                <twig:ContactSection :form="contact_form" />
            </div>
        </section>

        <twig:Footer :newsletter_form="newsletter_form" />
    </div>
{% endblock %}
